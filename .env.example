# Example environment configuration for Safechain Backend
# Copy this file to .env and replace placeholders with real values

# Server configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=https://your-dashboard.example.com

# JWT secrets
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (SMTP) configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@safechain.org

# Twilio (SMS) configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking configuration
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key

# Supabase configuration
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_KEY=your_supabase_key

# Encryption key (32-byte base64)
ENCRYPTION_KEY=your_32_byte_base64_key

# Additional secrets (if any)
# API_KEY=your_api_key
# PRIVATE_ENDPOINT=https://private.example.com
